{
  "type": "object",
  "required": ["version", "name", "on", "jobs"],
  "properties": {
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "name": { "type": "string", "maxLength": 128 },
    "on": {
      "type": "object",
      "minProperties": 1
    },
    "concurrency": { "type": "integer" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "variables": {
      "type": "array",
      "items": { 
        "type": "object", 
        "required": ["name", "expression"],
        "properties": {
          "name": {"type":"string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "expression": {"type":"string"},
          "visibility": {"enum": ["public","private"]}
        }
      }
    },
    "jobs": {
      "type": "object",
      "properties": {
        "variables": {
          "type": "array",
          "items": { 
            "type": "object", 
            "required": ["name", "expression"],
            "properties": {
              "name": {"type":"string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "expression": {"type":"string"},
              "visibility": {"enum": ["public","private"]}
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["task", "if", "switch", "fork", "join", "loop", "wait_signal", "wait_timer", "transform", "export"] },
          "name": { "type": "string" },
          "depends_on": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["job"],
                      "properties": {
                        "job": { "type": "string" },
                        "conditions": {
                          "type": "array",
                          "items": { "type": "string", "enum": ["onSuccess", "onFailure", "onCompletion", "onSkip"] },
                          "minItems": 1
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "variables": {
                  "type": "array",
                  "items": { 
                    "type": "object", 
                    "required": ["name", "expression"],
                    "properties": {
                      "name": {"type":"string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                      "expression": {"type":"string"},
                      "visibility": {"enum": ["public","private"]}
                    }
                  }
                },
                "http": {
                  "type": "object",
                  "required": ["method", "url"],
                  "properties": {
                    "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                    "url": { "type": "string" },
                    "headers": { "type": "object" },
                    "body": { "type": "object" },
                    "timeout": { "type": "string" },
                    "mtls_profile": { "type": "string" },
                    "stream": { "type": "boolean" },
                    "chunk_size": { "type": "integer" }
                  }
                },
                "uses": { "type": "string" },
                "with": { "type": "object" },
                "sandboxed": { "type": "boolean" },
                "timeout": { "type": "string" },
                "retry_attempts": { "type": "integer" },
                "retry_backoff": { "type": "string" },
                "retry_delay": { "type": "string" },
                "outputs": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "provider": { "type": "string" },
                "args": { "type": "object" },
                "on_error": {
                  "type": "object",
                  "required": ["fallback"],
                  "properties": {
                    "fallback": {
                      "anyOf": [
                        { "type": "string" },
                        { "type": "object" },
                        { "type": "array" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "condition": { "type": "string" },
          "then": {
            "type": "array",
            "items": { "type": "string" }
          },
          "else": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["condition", "then"],
              "properties": {
                "condition": { "type": "string" },
                "then": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "default": {
            "type": "array",
            "items": { "type": "string" }
          },
          "branches": {
            "type": "array",
            "items": { "type": "string" }
          },
          "strategy": { "type": "string" },
          "n_required": { "type": "integer" },
          "loop_type": { "type": "string", "enum": ["while", "for_each", "stream_chunk"] },
          "max_iterations": { "type": "integer" },
          "items": { "type": "string" },
          "source": { "type": "string" },
          "chunk_record_limit": { "type": "integer" },
          "correlation_id": { "type": "string" },
          "duration": { "type": "string" },
          "spec": {
            "type": "object",
            "properties": {
              "expression": { "type": "string" },
              "file": { "type": "string" },
              "data": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "object" },
                  { "type": "array" }
                ]
              }
            }
          },
          "start": { "type": "boolean" },
          "end": { "type": "boolean" },
          "return": {
            "anyOf": [
              { "type": "string" },
              { "type": "object" },
              { "type": "array" }
            ]
          },
          "cache": {
            "anyOf": [
              { "type": "boolean" },
              {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "ttl": {
                    "anyOf": [
                      { "type": "integer" },
                      { "type": "string" }
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  }
}
