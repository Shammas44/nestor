{
  "version": "2.0.0",
  "name": "Secrets Management and Redaction Example",
  "on": { "manual": {} },
  "jobs": {
    "redact_job": {
      "type": "task",
      "steps": [
        {
          "id": "deploy_step",
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:8080/api/deploy/secret",
            "headers": {
              "Authorization": "Bearer ${{ secrets.API_KEY }}"
            }
          }
        }
      ]
    }
  }
}
