{
  "version": "2.0.0",
  "name": "SWAPI Character Deep Dive",
  "on": { "manual": {} },
  "jobs": {
    "fetch_character": {
      "type": "task",
      "steps": [
        {
          "id": "get_luke",
          "http": {
            "method": "GET",
            "url": "https://swapi.dev/api/people/1/"
          }
        }
      ]
    },
    "fetch_homeworld": {
      "type": "task",
      "depends_on": ["fetch_character"],
      "steps": [
        {
          "id": "get_planet",
          "http": {
            "method": "GET",
            "url": "${{ jobs.fetch_character.steps.get_luke.body.homeworld }}"
          }
        }
      ]
    },
    "evaluate_planet": {
      "type": "if",
      "depends_on": ["fetch_homeworld"],
      "condition": "${{ jobs.fetch_homeworld.steps.get_planet.body.population > 100000 }}",
      "then": ["heavily_populated"],
      "else": ["sparsely_populated"]
    },
    "heavily_populated": {
      "type": "task",
      "steps": [
        {
          "id": "log_heavy",
          "uses": "./plugins/mock_plugin",
          "with": {
            "message": "Planet is heavily populated"
          }
        }
      ]
    },
    "sparsely_populated": {
      "type": "task",
      "steps": [
        {
          "id": "log_sparse",
          "uses": "./plugins/mock_plugin",
          "with": {
            "message": "Planet is sparsely populated"
          }
        }
      ]
    }
  }
}
