{
  "version": "2.0.0",
  "name": "SWAPI Secret Authorized Proxy",
  "on": { "manual": {} },
  "jobs": {
    "query_proxy": {
      "type": "task",
      "steps": [
        {
          "id": "get_proxied_character",
          "http": {
            "method": "GET",
            "url": "https://swapi.dev/api/people/2/",
            "headers": {
              "Authorization": "Bearer ${{ secrets.SWAPI_PROXY_KEY }}",
              "X-Request-Context": "nestor-enterprise-gateway"
            }
          }
        }
      ]
    }
  }
}
