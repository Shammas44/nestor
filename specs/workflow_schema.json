{
  "type": "object",
  "required": ["version", "name", "on", "jobs"],
  "properties": {
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "name": { "type": "string", "maxLength": 128 },
    "on": {
      "type": "object",
      "minProperties": 1
    },
    "concurrency": { "type": "integer" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["task", "if", "switch", "fork", "join", "loop", "wait_signal", "wait_timer", "transform"] },
          "name": { "type": "string" },
          "depends_on": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["job"],
                      "properties": {
                        "job": { "type": "string" },
                        "conditions": {
                          "type": "array",
                          "items": { "type": "string", "enum": ["onSuccess", "onFailure", "onCompletion", "onSkip"] },
                          "minItems": 1
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "http": {
                  "type": "object",
                  "required": ["method", "url"],
                  "properties": {
                    "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                    "url": { "type": "string" },
                    "headers": { "type": "object" },
                    "body": { "type": "object" },
                    "timeout": { "type": "string" },
                    "mtls_profile": { "type": "string" },
                    "stream": { "type": "boolean" },
                    "chunk_size": { "type": "integer" }
                  }
                },
                "uses": { "type": "string" },
                "with": { "type": "object" },
                "sandboxed": { "type": "boolean" },
                "timeout": { "type": "string" },
                "retry_attempts": { "type": "integer" },
                "retry_backoff": { "type": "string" },
                "retry_delay": { "type": "string" },
                "outputs": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          },
          "condition": { "type": "string" },
          "then": {
            "type": "array",
            "items": { "type": "string" }
          },
          "else": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["condition", "then"],
              "properties": {
                "condition": { "type": "string" },
                "then": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "default": {
            "type": "array",
            "items": { "type": "string" }
          },
          "branches": {
            "type": "array",
            "items": { "type": "string" }
          },
          "strategy": { "type": "string" },
          "n_required": { "type": "integer" },
          "loop_type": { "type": "string", "enum": ["while", "for_each", "stream_chunk"] },
          "max_iterations": { "type": "integer" },
          "items": { "type": "string" },
          "source": { "type": "string" },
          "chunk_record_limit": { "type": "integer" },
          "correlation_id": { "type": "string" },
          "duration": { "type": "string" },
          "start": { "type": "boolean" },
          "end": { "type": "boolean" },
          "return": {
            "anyOf": [
              { "type": "string" },
              { "type": "object" },
              { "type": "array" }
            ]
          }
        }
      }
    }
  }
}
